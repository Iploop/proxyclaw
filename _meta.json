{
  "name": "proxyclaw",
  "version": "3.0.0",
  "description": "Residential proxy CLI with explicit V2 credentials, country routing and sticky sessions; city is V2 pending deployment.",
  "author": "iploop",
  "license": "MIT",
  "homepage": "https://proxyclaw.ai",
  "keywords": [
    "proxy",
    "residential-proxy",
    "web-scraping",
    "anti-bot",
    "anti-detection",
    "tls-fingerprint",
    "captcha",
    "geo-targeting",
    "iploop",
    "proxyclaw",
    "ai-agent",
    "scraping",
    "unblocking",
    "site-presets",
    "chrome-fingerprint"
  ],
  "tags": [
    "proxy",
    "residential",
    "scraping",
    "geo-targeting",
    "web-access",
    "anti-detection"
  ],
  "openclaw": {
    "emoji": "\ud83c\udf10",
    "requires": {
      "bins": [
        "bash",
        "curl",
        "python3"
      ],
      "env": [
        "IPLOOP_API_KEY"
      ]
    },
    "primaryEnv": "IPLOOP_API_KEY"
  },
  "v2": {
    "signup": "https://platform.iploop.io/",
    "credentials": [
      "IPLOOP_API_KEY",
      "IPLOOP_PROXY_USERNAME",
      "IPLOOP_PROXY_PASSWORD"
    ],
    "city": "V2 pending server deployment; rollout-gated"
  },
  "features": [
    "v2-explicit-credentials",
    "legacy-compatibility",
    "country-routing",
    "sticky-sessions",
    "v2-city-pending-rollout"
  ]
}
